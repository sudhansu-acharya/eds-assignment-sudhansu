      ],
      "representativeUrl": "https://www.wknd.site/us/en/adventures.html",
      "description": "WKND adventures listing page - hero teaser and adventure cards grid",
      "urlPattern": "/us/en/*",
      "blocks": [
        {
          "name": "hero-banner",
          "instances": [
            ".teaser.cmp-teaser--hero"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            ".cmp-tabs__tabpanel--active .image-list.list"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Page title",
          "selector": "main.cmp-layout-container--fixed:nth-of-type(1)",
          "style": null,
          "blocks": [],
          "defaultContent": ["h1"]
        },
        {
          "id": "section-2",
          "name": "Adventures teaser hero",
          "selector": ".teaser.cmp-teaser--hero",
          "style": null,
          "blocks": ["hero-banner"],
          "defaultContent": []
        },
        {
          "id": "section-3",
          "name": "Current Adventures listing",
          "selector": ".tabs.panelcontainer",
          "style": null,
          "blocks": ["cards-article"],
          "defaultContent": []
        }
      ]
    },
    {
      "name": "magazine",
      "urls": [
        "https://www.wknd.site/us/en/magazine.html"
      ],
      "representativeUrl": "https://www.wknd.site/us/en/magazine.html",
      "description": "WKND magazine listing page - featured article, all articles grid, members-only teasers",
      "urlPattern": "/us/en/*",
      "blocks": [
        {
          "name": "columns-featured",
          "instances": [
            ".teaser.cmp-teaser--featured"
          ]
        },
        {
          "name": "cards-article",
          "instances": [
            ".image-list.list",
            ".teaser.cmp-teaser--secure"
          ]
        }
      ],
      "sections": [
        {
          "id": "section-1",
          "name": "Page title",
          "selector": "main.cmp-layout-container--fixed:nth-of-type(1)",
          "style": null,
          "blocks": [],
          "defaultContent": ["h1"]
        },
        {
          "id": "section-2",
