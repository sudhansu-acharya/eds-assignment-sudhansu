        {
          "id": "section-3",
          "name": "All articles grid",
          "selector": ".image-list.list",
          "style": null,
          "blocks": ["cards-article"],
          "defaultContent": []
        },
        {
          "id": "section-4",
          "name": "Members Only teasers",
          "selector": ".teaser.cmp-teaser--secure",
          "style": null,
          "blocks": ["cards-article"],
          "defaultContent": []
        }
      ]
    }
  ]
